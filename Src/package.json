{
  "name": "mforge-mumps-vista-ide",
  "displayName": "MForge MUMPS & VistA IDE",
  "description": "A modern VS Code IDE toolkit for MUMPS, GT.M/YottaDB, InterSystems-style M code, and VistA/Hakeem development.",
  "version": "0.6.3",
  "publisher": "dopamind",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MusabAlzoubi/MForge-MUMPS-Vista-IDE.git"
  },
  "bugs": {
    "url": "https://github.com/MusabAlzoubi/MForge-MUMPS-Vista-IDE/issues"
  },
  "homepage": "https://github.com/MusabAlzoubi/MForge-MUMPS-Vista-IDE#readme",
  "icon": "icon.png",
  "categories": [
    "Programming Languages",
    "Formatters",
    "Debuggers",
    "Linters",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "MUMPS",
    "M",
    "VistA",
    "GT.M",
    "YottaDB",
    "FileMan",
    "M Language",
    "Healthcare",
    "CPRS",
    "VA",
    "WorldVistA",
    "Hakeem",
    "Routine",
    "Globals",
    "MUMPS IDE",
    "MUMPS Debugger",
    "MUMPS Formatter",
    "VistA Toolkit"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onLanguage:mumps",
    "onCommand:mforge.showGettingStarted",
    "onCommand:mforge.applyRecommendedHakeemSettings",
    "onCommand:mforge.repairHakeemRoutineSettings",
    "onCommand:mforge.clearDirectDebugOutput",
    "onCommand:mforge.configureZstepLinePrinting",
    "onCommand:mforge.copyLastDirectDebugOutput",
    "onCommand:mforge.debugReferencesInCurrentLine",
    "onCommand:mforge.directDebugSetup",
    "onCommand:mforge.directDebugSmokeTest",
    "onCommand:mforge.findRoutineInIndex",
    "onCommand:mforge.insertPatchChangeBlockTemplate",
    "onCommand:mforge.insertRoutineHeaderTemplate",
    "onCommand:mforge.openDirectDebugOutput",
    "onCommand:mforge.rebuildRoutineIndex",
    "onCommand:mforge.resetSettingsToDefaults",
    "onCommand:mforge.saveDetectedRoutinePathsToSettings",
    "onCommand:mforge.sendRawDebugCommand",
    "onCommand:mforge.showNavigationDiagnostics",
    "onCommand:mforge.showRoutineIndexStatus",
    "onCommand:mforge.showZposition",
    "onCommand:mforge.zbreak",
    "onCommand:mforge.zcontinue",
    "onCommand:mforge.zprint",
    "onCommand:mforge.zprintAtPosition",
    "onCommand:mforge.zshow",
    "onCommand:mforge.zstep",
    "onCommand:mforge.zstepInto",
    "onCommand:mforge.zstepOutOf",
    "onCommand:mforge.zwrite",
    "onCommand:mumps.clearDirectDebugOutput",
    "onCommand:mumps.configureZstepLinePrinting",
    "onCommand:mumps.copyLastDirectDebugOutput",
    "onCommand:mumps.directDebugSetup",
    "onCommand:mumps.directDebugSmokeTest",
    "onCommand:mumps.insertPatchChangeBlockTemplate",
    "onCommand:mumps.insertRoutineHeaderTemplate",
    "onCommand:mumps.openDirectDebugOutput",
    "onCommand:mumps.sendRawDebugCommand",
    "onCommand:mumps.showZposition",
    "onCommand:mumps.zbreak",
    "onCommand:mumps.zcontinue",
    "onCommand:mumps.zprint",
    "onCommand:mumps.zprintAtPosition",
    "onCommand:mumps.zshow",
    "onCommand:mumps.zstep",
    "onCommand:mumps.zstepInto",
    "onCommand:mumps.zstepOutOf",
    "onCommand:mumps.zwrite"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "npm run compile",
    "vscode:prepublish": "npm run compile",
    "env:check": "node scripts/check-env.js",
    "test:stage2": "node scripts/test-stage2.js",
    "test:stage3": "node scripts/test-stage3.js",
    "test": "npm run test:semantic-contributions && npm run test:stage2 && npm run test:stage3 && npm run test:stage4 && npm run test:stage45 && npm run test:stage46 && npm run test:stage5 && npm run test:legacy-parity && npm run test:release-polish && npm run test:hakeem-hardening",
    "package": "npm run env:check && npm run compile && npm run test && vsce package",
    "package:local": "npm run package",
    "install:local": "code --install-extension mforge-mumps-vista-ide-0.6.3.vsix",
    "test:stage4": "node scripts/test-stage4.js",
    "test:stage45": "node scripts/test-stage45.js",
    "test:stage46": "node scripts/test-stage46.js",
    "test:semantic-contributions": "node scripts/test-semantic-token-contributions.js",
    "test:stage5": "node scripts/test-stage5.js",
    "test:legacy-parity": "node scripts/test-legacy-parity.js",
    "test:release-polish": "node scripts/test-release-polish.js",
    "test:hakeem-hardening": "node scripts/test-hakeem-hardening.js"
  },
  "devDependencies": {
    "@types/node": "^18.19.1",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.2",
    "vsce": "2.11.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "mumps",
        "aliases": [
          "MForge MUMPS",
          "MUMPS",
          "M",
          "VistA MUMPS"
        ],
        "extensions": [
          ".m",
          ".M",
          ".mumps",
          ".mps",
          ".rou",
          ".int"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mumps",
        "scopeName": "source.mumps",
        "path": "./syntaxes/mumps.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "mumps",
        "path": "./snippets/mumps.json"
      }
    ],
    "commands": [
      {
        "command": "mforge.showGettingStarted",
        "title": "MForge: Show Getting Started"
      },
      {
        "command": "mforge.debugReferencesInCurrentLine",
        "title": "MForge: Debug References In Current Line"
      },
      {
        "command": "mforge.rebuildRoutineIndex",
        "title": "MForge: Rebuild Routine Index"
      },
      {
        "command": "mforge.findRoutineInIndex",
        "title": "MForge: Find Routine In Index"
      },
      {
        "command": "mforge.showRoutineIndexStatus",
        "title": "MForge: Show Routine Index Status"
      },
      {
        "command": "mforge.saveDetectedRoutinePathsToSettings",
        "title": "MForge: Save Detected Routine Paths To Settings"
      },
      {
        "command": "mforge.showNavigationDiagnostics",
        "title": "MForge: Show Navigation Diagnostics"
      },
      {
        "command": "mforge.insertRoutineHeaderTemplate",
        "title": "MForge: Insert Routine Header Template"
      },
      {
        "command": "mforge.insertPatchChangeBlockTemplate",
        "title": "MForge: Insert Patch Change Block Template"
      },
      {
        "command": "mforge.zstep",
        "title": "MForge: ZSTEP"
      },
      {
        "command": "mforge.zcontinue",
        "title": "MForge: ZCONTINUE"
      },
      {
        "command": "mforge.zwrite",
        "title": "MForge: ZWRITE"
      },
      {
        "command": "mforge.zshow",
        "title": "MForge: ZSHOW"
      },
      {
        "command": "mforge.zbreak",
        "title": "MForge: ZBREAK"
      },
      {
        "command": "mforge.zprintAtPosition",
        "title": "MForge: ZPRINT At Current Position"
      },
      {
        "command": "mforge.zstepInto",
        "title": "MForge: ZSTEP INTO"
      },
      {
        "command": "mforge.zstepOutOf",
        "title": "MForge: ZSTEP OUTOF"
      },
      {
        "command": "mforge.zprint",
        "title": "MForge: ZPRINT"
      },
      {
        "command": "mforge.configureZstepLinePrinting",
        "title": "MForge: Configure $ZSTEP Line Printing"
      },
      {
        "command": "mforge.showZposition",
        "title": "MForge: Show $ZPOSITION"
      },
      {
        "command": "mforge.directDebugSetup",
        "title": "MForge: Direct Debug Setup"
      },
      {
        "command": "mforge.directDebugSmokeTest",
        "title": "MForge: Direct Debug Smoke Test"
      },
      {
        "command": "mforge.sendRawDebugCommand",
        "title": "MForge: Send Raw Debug Command"
      },
      {
        "command": "mforge.openDirectDebugOutput",
        "title": "MForge: Open Direct Debug Output"
      },
      {
        "command": "mforge.copyLastDirectDebugOutput",
        "title": "MForge: Copy Last Direct Debug Output"
      },
      {
        "command": "mforge.clearDirectDebugOutput",
        "title": "MForge: Clear Direct Debug Output"
      },
      {
        "command": "mforge.applyRecommendedHakeemSettings",
        "title": "MForge: Apply Recommended Hakeem Settings"
      },
      {
        "command": "mforge.repairHakeemRoutineSettings",
        "title": "MForge: Repair Hakeem Routine Settings"
      },
      {
        "command": "mforge.resetSettingsToDefaults",
        "title": "MForge: Reset MForge Settings To Defaults"
      }
    ],
    "configurationDefaults": {
      "[mumps]": {
        "editor.tabSize": 1,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.wordSeparators": "`~!@#%$^&*()-=+[{]}\\|;:'\",.<>/?"
      }
    },
    "configuration": {
      "title": "MForge MUMPS & VistA IDE",
      "properties": {
        "mforge.trace.level": {
          "type": "string",
          "enum": [
            "off",
            "info",
            "debug"
          ],
          "default": "off",
          "description": "Controls diagnostic logging for MForge extension features."
        },
        "mforge.formatter.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the conservative MForge document formatter for MUMPS files."
        },
        "mforge.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable basic MForge diagnostics for MUMPS files."
        },
        "mforge.navigation.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable MUMPS navigation features: document links, Ctrl+Click, definitions, routine indexing, document symbols, and workspace symbols."
        },
        "mforge.maxWorkspaceFiles": {
          "type": "number",
          "default": 5000,
          "minimum": 1,
          "description": "Maximum number of supported MUMPS routine files to scan from the active workspace. Configured routine search paths use mforge.maxRoutineSearchPathFiles."
        },
        "mforge.hover.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Stage 4 MUMPS hover help for commands, intrinsic functions, and system variables."
        },
        "mforge.completion.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Stage 4 MUMPS completion for commands, intrinsics, system variables, labels, and routines."
        },
        "mforge.signatureHelp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Stage 4 MUMPS intrinsic function signature help."
        },
        "mforge.semanticHighlighting.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Stage 4.5 semantic highlighting for MUMPS files."
        },
        "mforge.workspaceScanDebounceMs": {
          "type": "number",
          "default": 250,
          "minimum": 0,
          "description": "Debounce interval in milliseconds before marking the MUMPS workspace routine index dirty after file events."
        },
        "mforge.routineSearchPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional absolute or workspace-relative folders to scan for MUMPS routine files outside the active workspace root."
        },
        "mforge.indexExtensionlessRoutines": {
          "type": "boolean",
          "default": false,
          "description": "Index extensionless routine files in workspace and mforge.routineSearchPaths. Enable for VistA/YottaDB exports that omit file extensions."
        },
        "mforge.autoDetectRoutinePaths": {
          "type": "boolean",
          "default": true,
          "description": "Automatically detects common VistA/YottaDB routine folders and adds them to the routine index without modifying user settings."
        },
        "mforge.autoRebuildIndexOnActivation": {
          "type": "boolean",
          "default": true,
          "description": "Automatically rebuilds the MUMPS routine index shortly after activation when routine folders are detected."
        },
        "mforge.references.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Stage 5.1 Find References for local labels, cross-routine LABEL^ROUTINE calls, and same-document local variables."
        },
        "mforge.references.includeDeclarations": {
          "type": "boolean",
          "default": true,
          "description": "Include label declarations or routine-top fallback locations in MForge Find References results when VS Code requests declarations."
        },
        "mforge.references.maxResults": {
          "type": "number",
          "default": 5000,
          "minimum": 1,
          "description": "Maximum number of locations returned by MForge Find References before truncating results."
        },
        "mforge.maxRoutineSearchPathFiles": {
          "type": "number",
          "default": 30000,
          "minimum": 1,
          "description": "Maximum number of supported MUMPS routine files to scan from configured or auto-detected routine search paths."
        },
        "mforge.standards.profile": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "vista",
            "ujo",
            "custom"
          ],
          "description": "Standards profile used by MForge diagnostics and templates."
        },
        "mforge.standards.enforceRoutineHeader": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, check routine header metadata format."
        },
        "mforge.standards.namespacePrefixes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Allowed routine namespace prefixes for standards checks."
        },
        "mforge.standards.enforceLabelLength": {
          "type": "boolean",
          "default": true,
          "description": "When a standards profile is active, warn when entry point labels exceed 8 characters."
        },
        "mforge.standards.enforceLocalVariableNames": {
          "type": "boolean",
          "default": true,
          "description": "When a standards profile is active, warn when local variables exceed 16 characters or contain lowercase characters."
        },
        "mforge.standards.enforceTmpGlobalSubscript": {
          "type": "boolean",
          "default": true,
          "description": "When a standards profile is active, warn when ^TMP is not scoped by $J or package namespace followed by $J."
        },
        "mforge.standards.enforcePercentGlobalProtection": {
          "type": "boolean",
          "default": true,
          "description": "When a standards profile is active, warn on READ/KILL/SET/MERGE operations against ^% globals."
        },
        "mforge.debug.showOutputOnCommand": {
          "type": "boolean",
          "default": true,
          "description": "Show the MForge MUMPS Debug output channel whenever a direct debug command is sent."
        },
        "mforge.debug.directCommandTimeoutMs": {
          "type": "number",
          "default": 5000,
          "minimum": 1000,
          "description": "Timeout in milliseconds while waiting for output from a direct MDEBUG command."
        }
      }
    },
    "themes": [
      {
        "label": "MForge Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/MForge Dark-color-theme.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "mumps-label",
        "superType": "function",
        "description": "MUMPS routine label definitions."
      },
      {
        "id": "mumps-command",
        "superType": "keyword",
        "description": "MUMPS commands and command abbreviations."
      },
      {
        "id": "mumps-intrinsic",
        "superType": "function",
        "description": "MUMPS intrinsic functions."
      },
      {
        "id": "mumps-global",
        "superType": "variable",
        "description": "MUMPS global variable references."
      },
      {
        "id": "mumps-system-variable",
        "superType": "variable",
        "description": "MUMPS system variables."
      },
      {
        "id": "mumps-parameter",
        "superType": "parameter",
        "description": "MUMPS label parameters."
      },
      {
        "id": "mumps-local-variable",
        "superType": "variable",
        "description": "MUMPS local variables."
      },
      {
        "id": "mumps-api",
        "superType": "function",
        "description": "Common FileMan and VistA-style API entry points."
      },
      {
        "id": "mumps-routine-reference",
        "superType": "namespace",
        "description": "MUMPS routine references."
      },
      {
        "id": "mumps-navigable-routine-reference",
        "superType": "namespace",
        "description": "MUMPS routine references that are likely navigable."
      },
      {
        "id": "mumps-unresolved-routine-reference",
        "superType": "namespace",
        "description": "MUMPS routine references whose target routine is not currently indexed."
      }
    ],
    "debuggers": [
      {
        "type": "mumps",
        "label": "MForge MUMPS Debugger",
        "program": "./out/debug/mumpsDebugAdapter.js",
        "runtime": "node",
        "languages": [
          "mumps"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program",
              "localRoutinesPath"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to the routine/program to debug."
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": true,
                "description": "Automatically stop after launch."
              },
              "localRoutinesPath": {
                "type": "string",
                "description": "Local routine directory mapped to the MDEBUG runtime."
              }
            }
          },
          "attach": {
            "required": [
              "hostname",
              "port",
              "localRoutinesPath"
            ],
            "properties": {
              "hostname": {
                "type": "string",
                "default": "127.0.0.1",
                "description": "MDEBUG host to attach to."
              },
              "port": {
                "type": "number",
                "default": 3000,
                "description": "MDEBUG port to attach to."
              },
              "localRoutinesPath": {
                "type": "string",
                "description": "Local routine directory mapped to the MDEBUG runtime."
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false,
                "description": "Step once after attach."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "name": "MForge MUMPS: Launch via MDEBUG",
            "type": "mumps",
            "request": "launch",
            "program": "${file}",
            "localRoutinesPath": "${workspaceFolder}",
            "stopOnEntry": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "MForge MUMPS Launch",
            "description": "Launch a MUMPS routine through MDEBUG",
            "body": {
              "name": "MForge MUMPS: Launch",
              "type": "mumps",
              "request": "launch",
              "program": "${file}",
              "localRoutinesPath": "${workspaceFolder}",
              "stopOnEntry": true
            }
          },
          {
            "label": "MForge MUMPS Attach",
            "description": "Attach to an existing MDEBUG server",
            "body": {
              "name": "MForge MUMPS: Attach",
              "type": "mumps",
              "request": "attach",
              "hostname": "127.0.0.1",
              "port": 3000,
              "localRoutinesPath": "${workspaceFolder}",
              "stopOnEntry": false
            }
          }
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "mumps"
      }
    ],
    "views": {
      "debug": [
        {
          "id": "mforgeDirectDebug",
          "name": "MForge MUMPS Direct Debug",
          "when": "inDebugMode && debugType == mumps"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mforgeDirectDebug",
        "contents": "Start a MUMPS debug session to use MDEBUG Direct Debug controls.\n[Direct Debug Setup](command:mforge.directDebugSetup)\n[Smoke Test](command:mforge.directDebugSmokeTest)",
        "when": "!inDebugMode"
      }
    ],
    "menus": {
      "debug/toolBar": [
        {
          "command": "mforge.directDebugSmokeTest",
          "when": "inDebugMode && debugType == mumps",
          "group": "mforge@-1"
        },
        {
          "command": "mforge.directDebugSetup",
          "when": "inDebugMode && debugType == mumps",
          "group": "mforge@0"
        },
        {
          "command": "mforge.zbreak",
          "when": "inDebugMode && debugType == mumps",
          "group": "mforge@1"
        },
        {
          "command": "mforge.zprintAtPosition",
          "when": "inDebugMode && debugType == mumps",
          "group": "mforge@2"
        },
        {
          "command": "mforge.zwrite",
          "when": "inDebugMode && debugType == mumps",
          "group": "mforge@3"
        },
        {
          "command": "mforge.zshow",
          "when": "inDebugMode && debugType == mumps",
          "group": "mforge@4"
        },
        {
          "command": "mforge.configureZstepLinePrinting",
          "when": "inDebugMode && debugType == mumps",
          "group": "mforge@5"
        },
        {
          "command": "mforge.showZposition",
          "when": "inDebugMode && debugType == mumps",
          "group": "mforge@6"
        }
      ],
      "view/title": [
        {
          "command": "mforge.directDebugSmokeTest",
          "when": "view == mforgeDirectDebug",
          "group": "navigation@0"
        },
        {
          "command": "mforge.openDirectDebugOutput",
          "when": "view == mforgeDirectDebug",
          "group": "navigation@1"
        },
        {
          "command": "mforge.clearDirectDebugOutput",
          "when": "view == mforgeDirectDebug",
          "group": "navigation@2"
        }
      ]
    }
  },
  "overrides": {
    "cheerio": "1.0.0-rc.12"
  },
  "author": "Musab Alzoubi"
}
