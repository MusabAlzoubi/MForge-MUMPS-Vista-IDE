{
  "name": "mforge-mumps-vista-ide",
  "displayName": "MForge MUMPS & VistA IDE",
  "description": "Complete IDE toolkit for MUMPS and VistA development in Visual Studio Code.",
  "version": "0.3.0",
  "publisher": "dopamind",
  "license": "MIT",
  "icon": "icon.png",
  "categories": [
    "Programming Languages",
    "Formatters",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "MUMPS",
    "M",
    "VistA",
    "GT.M",
    "YottaDB",
    "FileMan",
    "healthcare"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onLanguage:mumps",
    "onCommand:mforge.showGettingStarted"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "npm run compile",
    "vscode:prepublish": "npm run compile",
    "env:check": "node scripts/check-env.js",
    "test:stage2": "node scripts/test-stage2.js",
    "test:stage3": "node scripts/test-stage3.js",
    "test": "npm run test:stage2 && npm run test:stage3",
    "package": "npm run env:check && npm run compile && npm run test && vsce package",
    "package:local": "npm run package",
    "install:local": "code --install-extension mforge-mumps-vista-ide-0.3.0.vsix"
  },
  "devDependencies": {
    "@types/node": "^18.19.1",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.2",
    "vsce": "2.11.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "mumps",
        "aliases": [
          "MForge MUMPS",
          "MUMPS",
          "M",
          "VistA MUMPS"
        ],
        "extensions": [
          ".m",
          ".M",
          ".mumps",
          ".mps",
          ".rou",
          ".int"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mumps",
        "scopeName": "source.mumps",
        "path": "./syntaxes/mumps.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "mumps",
        "path": "./snippets/mumps.json"
      }
    ],
    "commands": [
      {
        "command": "mforge.showGettingStarted",
        "title": "MForge: Show Getting Started"
      }
    ],
    "configurationDefaults": {
      "[mumps]": {
        "editor.tabSize": 1,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.wordSeparators": "`~!@#%$^&*()-=+[{]}\\|;:'\",.<>/?"
      }
    },
    "configuration": {
      "title": "MForge MUMPS & VistA IDE",
      "properties": {
        "mforge.trace.level": {
          "type": "string",
          "enum": [
            "off",
            "info",
            "debug"
          ],
          "default": "off",
          "description": "Controls diagnostic logging for MForge extension features. Stage 1 has minimal logging."
        },
        "mforge.formatter.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the conservative MForge document formatter for MUMPS files."
        },
        "mforge.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable basic MForge diagnostics for MUMPS files."
        },
        "mforge.navigation.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Stage 3 MUMPS navigation features: document symbols, definitions, routine indexing, and workspace symbols."
        },
        "mforge.maxWorkspaceFiles": {
          "type": "number",
          "default": 2000,
          "minimum": 1,
          "description": "Maximum number of supported MUMPS routine files to scan for the Stage 3 workspace routine index."
        }
      }
    }
  },
  "overrides": {
    "cheerio": "1.0.0-rc.12"
  }
}
